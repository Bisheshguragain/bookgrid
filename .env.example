# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Email Service Configuration (Brevo/Sendinblue)
# Get your API key from: https://app.brevo.com/settings/keys/api
VITE_BREVO_API_KEY=your-brevo-api-key

# Application URLs
VITE_APP_URL=https://bookagreed.com
VITE_APP_NAME=BookAgreed

# Email Configuration
# The sender email MUST be verified in your Brevo account
VITE_EMAIL_FROM=noreply@bookagreed.com
VITE_EMAIL_FROM_NAME=BookAgreed
VITE_SUPPORT_EMAIL=support@bookagreed.com

# Superadmin Email (receives notifications for contact forms, signups, etc.)
VITE_SUPERADMIN_EMAIL=admin@yourdomain.com

# Anti-Spam: Cloudflare Turnstile CAPTCHA (Optional)
# Get keys from: https://dash.cloudflare.com/?to=/:account/turnstile
VITE_TURNSTILE_SITE_KEY=your-turnstile-site-key

# Note: TURNSTILE_SECRET_KEY should be set as a Supabase Edge Function secret:
# supabase secrets set TURNSTILE_SECRET_KEY=your-secret-key
