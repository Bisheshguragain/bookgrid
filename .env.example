# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Email Service Configuration (Resend)
RESEND_API_KEY=your-resend-api-key
VITE_APP_URL=https://bookgrid.com
VITE_APP_NAME=BookGrid

# Email Configuration
EMAIL_FROM=noreply@bookgrid.com
SUPPORT_EMAIL=support@bookgrid.com

# Anti-Spam: Cloudflare Turnstile CAPTCHA (Optional)
# Get keys from: https://dash.cloudflare.com/?to=/:account/turnstile
VITE_TURNSTILE_SITE_KEY=your-turnstile-site-key

# Note: TURNSTILE_SECRET_KEY should be set as a Supabase Edge Function secret:
# supabase secrets set TURNSTILE_SECRET_KEY=your-secret-key
